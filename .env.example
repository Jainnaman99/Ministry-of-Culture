# Copy to .env and fill in real values (or set env vars another way). Never commit .env.
# Node 20.6+ supports loading via: node --env-file=.env server/index.mjs
# The server also reads .env directly if present.

# ===== Required: Azure OpenAI / Foundry =====
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ===== Optional: Azure AI Search for RAG over the 3 priority sites =====
# Leave blank to start. Add later once you've indexed indianculture.gov.in,
# vedicheritage.gov.in, museumsofindia.gov.in into an AI Search index.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=
AZURE_SEARCH_KEY=

# ===== Server config =====
PORT=3001
